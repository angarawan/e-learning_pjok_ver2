    <script>
        // URL WEB APP GOOGLE APPS SCRIPT ANDA
        const GAS_URL = "https://script.google.com/macros/s/AKfycbxFIUm7eiCkVDUtopgIMXg8hHuHHcFHUYr98DGpBKCRrKNH14biz58zO_OQ4RCyPMk/exec"; 

        function showModal(title, message, isSuccess = true) {
            const modal = document.getElementById('globalModal');
            const icon = document.getElementById('modalIcon');
            if (!modal || !icon) return;
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalMessage').innerText = message;
            icon.innerHTML = isSuccess
                ? '<i class="fa-solid fa-circle-check text-green-500"></i>'
                : '<i class="fa-solid fa-circle-exclamation text-red-500"></i>';
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            const modal = document.getElementById('globalModal');
            if (!modal) return;
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
        window.closeModal = closeModal;

        function setLoading(show) {
            const el = document.getElementById('loadingScreen');
            if (!el) return;
            if (show) {
                el.classList.remove('hidden');
                el.classList.add('flex');
            } else {
                el.classList.add('hidden');
                el.classList.remove('flex');
            }
        }

        async function api(payload) {
            const response = await fetch(GAS_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify(payload)
            });
            const rawText = await response.text();
            let json;
            try {
                json = JSON.parse(rawText);
            } catch (e) {
                throw new Error('Server Apps Script belum memberikan respons JSON. Pastikan Web App sudah di-Deploy dengan akses "Anyone" (Siapa saja).');
            }
            if (json.status === 'error') throw new Error(json.message || 'Terjadi kesalahan server.');
            return json;
        }

        function convertDriveUrl(url, mode = 'image') {
            if (!url) return '';
            const cleanUrl = String(url).trim();
            const match = cleanUrl.match(/\/d\/([a-zA-Z0-9_-]+)/) || cleanUrl.match(/[?&]id=([a-zA-Z0-9_-]+)/);
            if (match && cleanUrl.includes('drive.google.com')) {
                const fileId = match[1];
                return mode === 'video'
                    ? `https://drive.google.com/file/d/${fileId}/preview`
                    : `https://lh3.googleusercontent.com/d/${fileId}`;
            }
            return cleanUrl;
        }

        function formatInlineStyles(text, theme = 'orange') {
            const badgeThemes = {
                orange: 'bg-brand-orange/20 text-orange-200 border border-brand-orange/40',
                blue: 'bg-blue-500/20 text-blue-200 border border-blue-400/40',
                purple: 'bg-purple-500/20 text-purple-200 border border-purple-400/40',
                teal: 'bg-teal-500/20 text-teal-200 border border-teal-400/40'
            };
            const badgeClass = badgeThemes[theme] || badgeThemes.orange;

            let formatted = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

            // Link markdown [Teks](URL)
            formatted = formatted.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
                '<a href="$2" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1 my-1 rounded-lg bg-emerald-600/30 hover:bg-emerald-600/50 border border-emerald-400/40 text-emerald-200 font-semibold text-xs transition-all"><i class="fa-solid fa-up-right-from-square"></i> $1</a>');

            // Teks tebal **...**
            formatted = formatted.replace(/\*\*([^*]+)\*\*/g,
                `<strong class="font-bold px-2 py-0.5 rounded-md ${badgeClass}">$1</strong>`);

            // Teks miring *...*
            formatted = formatted.replace(/\*([^*]+)\*/g, '<em class="italic text-gray-200">$1</em>');

            return formatted;
        }

        function parseMediaTags(rawText, theme = 'orange') {
            if (!rawText) return '';
            const cardThemes = {
                orange: 'bg-orange-500/10 border-l-4 border-brand-orange',
                blue: 'bg-blue-500/10 border-l-4 border-blue-400',
                purple: 'bg-purple-500/10 border-l-4 border-purple-400',
                teal: 'bg-teal-500/10 border-l-4 border-teal-400'
            };
            const cardClass = cardThemes[theme] || cardThemes.orange;

            const lines = String(rawText).split(/\r?\n/);
            let html = '';
            let inBoldBlock = false;

            for (let i = 0; i < lines.length; i++) {
                const rawLine = lines[i];
                const trimmed = rawLine.trim();

                // Tag [GAMBAR: url]
                const imgMatch = trimmed.match(/^\[GAMBAR:\s*(.+?)\]$/i);
                if (imgMatch) {
                    if (inBoldBlock) { html += '</div>'; inBoldBlock = false; }
                    const imgSrc = convertDriveUrl(imgMatch[1], 'image');
                    html += `<div class="media-container my-3"><img src="${imgSrc}" onerror="this.style.display='none'" alt="Media Pembelajaran"></div>`;
                    continue;
                }

                // Tag [VIDEO: url]
                const vidMatch = trimmed.match(/^\[VIDEO:\s*(.+?)\]$/i);
                if (vidMatch) {
                    if (inBoldBlock) { html += '</div>'; inBoldBlock = false; }
                    let vidUrl = vidMatch[1].trim();
                    const ytMatch = vidUrl.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
                    if (ytMatch) {
                        vidUrl = `https://www.youtube.com/embed/${ytMatch[1]}`;
                    } else {
                        vidUrl = convertDriveUrl(vidUrl, 'video');
                    }
                    html += `<div class="media-container my-3"><iframe src="${vidUrl}" allowfullscreen></iframe></div>`;
                    continue;
                }

                // Tag [APP: url]
                const appMatch = trimmed.match(/^\[APP:\s*(.+?)\]$/i);
                if (appMatch) {
                    if (inBoldBlock) { html += '</div>'; inBoldBlock = false; }
                    html += `<div class="media-container my-3"><iframe src="${appMatch[1].trim()}" style="min-height:420px;"></iframe></div>`;
                    continue;
                }

                // Baris kosong (Enter)
                if (trimmed === '') {
                    if (inBoldBlock) {
                        html += '</div>';
                        inBoldBlock = false;
                    }
                    html += '<div class="h-3"></div>';
                    continue;
                }

                // Baris diawali judul tebal **Judul**
                const headingBoldMatch = trimmed.match(/^\*\*([^*]+)\*\*(.*)$/);
                if (headingBoldMatch) {
                    if (inBoldBlock) html += '</div>';
                    const titlePart = headingBoldMatch[1];
                    const restPart = headingBoldMatch[2] ? formatInlineStyles(headingBoldMatch[2], theme) : '';
                    html += `<div class="p-3.5 md:p-4 rounded-xl ${cardClass} my-2.5 space-y-1.5">`;
                    html += `<div class="font-bold text-white text-xs md:text-sm">${titlePart}${restPart}</div>`;
                    inBoldBlock = true;
                    continue;
                }

                // Penomoran / bullet dengan hanging indent (tanpa warna mencolok pada angka/simbol)
                const listMatch = rawLine.match(/^(\s*)(\d+[.)]|[a-zA-Z][.)]|[-•*])\s+(.*)$/);
                if (listMatch) {
                    const marker = listMatch[2];
                    const content = formatInlineStyles(listMatch[3], theme);
                    html += `<div class="flex items-start gap-2 text-justify-custom leading-relaxed"><span class="font-semibold text-gray-200 shrink-0">${marker}</span><div class="flex-1">${content}</div></div>`;
                    continue;
                }

                // Baris biasa (pertahankan spasi awal)
                const leadingSpaces = rawLine.match(/^(\s*)/)[1].replace(/ /g, '&nbsp;');
                const formattedLine = formatInlineStyles(rawLine.trimStart(), theme);
                html += `<div class="text-justify-custom leading-relaxed">${leadingSpaces}${formattedLine}</div>`;
            }

            if (inBoldBlock) html += '</div>';
            return html;
        }

        Object.assign(window.app, {
            state: {
                studentName: '',
                className: '',
                materialId: '',
                materialTitle: '',
                dashboardData: null,
                progress: { materi: false, lkm: false, tugas: false, formatif: false, refleksi: false },
                quizScore: null,
                currentQuizIdx: 0,
                quizAnswers: [],
                lkmPhases: [],
                currentView: 'dashboard',
                history: ['dashboard']
            },

            init() {
                try {
                    this.loadInitialClasses();
                    this.restoreSession();
                } catch (e) {
                    console.error('Init warning:', e);
                }
            },

            saveSession() {
                try {
                    localStorage.setItem('pjok_session', JSON.stringify({
                        studentName: this.state.studentName,
                        className: this.state.className,
                        materialId: this.state.materialId,
                        materialTitle: this.state.materialTitle,
                        progress: this.state.progress,
                        quizScore: this.state.quizScore
                    }));
                } catch (e) {}
            },

            restoreSession() {
                try {
                    const saved = localStorage.getItem('pjok_session');
                    if (!saved) return;
                    const parsed = JSON.parse(saved);
                    if (parsed && parsed.studentName && parsed.className && parsed.materialId) {
                        this.state.studentName = parsed.studentName;
                        this.state.className = parsed.className;
                        this.state.materialId = parsed.materialId;
                        this.state.materialTitle = parsed.materialTitle || '';
                        this.state.progress = parsed.progress || this.state.progress;
                        this.state.quizScore = parsed.quizScore ?? null;
                    }
                } catch (e) {}
            },

            async loadInitialClasses() {
                const selectClass = document.getElementById('selectClass');
                if (!selectClass) return;
                selectClass.innerHTML = '<option value="">Memuat daftar kelas...</option>';
                try {
                    const res = await api({ action: 'getInitialData' });
                    const classes = (res && res.data && Array.isArray(res.data.classes)) ? res.data.classes : [];
                    selectClass.innerHTML = '<option value="">-- Pilih Kelas --</option>';
                    classes.forEach(cls => {
                        const opt = document.createElement('option');
                        opt.value = cls;
                        opt.textContent = cls;
                        selectClass.appendChild(opt);
                    });
                } catch (err) {
                    selectClass.innerHTML = '<option value="">-- Pilih Kelas --</option>';
                }
            },

            checkConnectionAndStart() {
                document.getElementById('view-welcome').classList.add('hidden');
                const idView = document.getElementById('view-identity');
                idView.classList.remove('hidden');
                idView.classList.add('flex');
                const selectClass = document.getElementById('selectClass');
                if (selectClass && selectClass.options.length <= 1) {
                    this.loadInitialClasses();
                }
            },

            async onClassChange() {
                const className = document.getElementById('selectClass').value;
                const selectStudent = document.getElementById('selectStudent');
                const selectMaterial = document.getElementById('selectMaterial');
                const btnContinue = document.getElementById('btnContinue');

                selectStudent.disabled = true;
                selectMaterial.disabled = true;
                btnContinue.disabled = true;

                if (!className) {
                    selectStudent.innerHTML = '<option value="">-- Pilih Nama --</option>';
                    selectMaterial.innerHTML = '<option value="">-- Pilih Materi --</option>';
                    return;
                }

                selectStudent.innerHTML = '<option value="">Memuat nama murid...</option>';
                selectMaterial.innerHTML = '<option value="">Memuat materi...</option>';

                try {
                    const res = await api({ action: 'getStudentsAndMaterials', className });
                    const students = (res && res.data && Array.isArray(res.data.students)) ? res.data.students : [];
                    const materials = (res && res.data && Array.isArray(res.data.materials)) ? res.data.materials : [];

                    selectStudent.innerHTML = students.length
                        ? '<option value="">-- Pilih Nama --</option>'
                        : '<option value="">-- Tidak ada murid di kelas ini --</option>';
                    students.forEach(st => {
                        const opt = document.createElement('option');
                        opt.value = st;
                        opt.textContent = st;
                        selectStudent.appendChild(opt);
                    });

                    selectMaterial.innerHTML = materials.length
                        ? '<option value="">-- Pilih Materi --</option>'
                        : '<option value="">-- Tidak ada materi aktif --</option>';
                    materials.forEach(mat => {
                        const opt = document.createElement('option');
                        opt.value = mat.id;
                        opt.textContent = mat.title;
                        selectMaterial.appendChild(opt);
                    });

                    selectStudent.disabled = false;
                    selectMaterial.disabled = false;

                    const checkReady = () => {
                        btnContinue.disabled = !(selectStudent.value && selectMaterial.value);
                    };
                    selectStudent.onchange = checkReady;
                    selectMaterial.onchange = checkReady;
                } catch (err) {
                    selectStudent.innerHTML = '<option value="">Gagal memuat data</option>';
                    selectMaterial.innerHTML = '<option value="">Gagal memuat materi</option>';
                }
            },

            async submitIdentity(e) {
                e.preventDefault();
                const className = document.getElementById('selectClass').value;
                const studentName = document.getElementById('selectStudent').value;
                const selectMaterial = document.getElementById('selectMaterial');
                const materialId = selectMaterial.value;
                const materialTitle = selectMaterial.options[selectMaterial.selectedIndex]?.text || materialId;

                if (!className || !studentName || !materialId) return;

                this.state.className = className;
                this.state.studentName = studentName;
                this.state.materialId = materialId;
                this.state.materialTitle = materialTitle;

                setLoading(true);
                try {
                    const res = await api({
                        action: 'getDashboardData',
                        studentName,
                        className,
                        materialId
                    });
                    this.state.dashboardData = res.data || {};
                    this.saveSession();
                    this.setupDashboard(this.state.dashboardData);

                    document.getElementById('view-identity').classList.add('hidden');
                    document.getElementById('view-identity').classList.remove('flex');
                    document.getElementById('view-main').classList.remove('hidden');
                    this.navigateTo('dashboard');
                } catch (err) {
                    showModal('Gagal Memuat', 'Tidak dapat mengambil data pembelajaran. Periksa koneksi internet Anda.', false);
                } finally {
                    setLoading(false);
                }
            },

            setupDashboard(data) {
                document.getElementById('lblStudentName').innerText = this.state.studentName;
                document.getElementById('lblStudentClass').innerText = this.state.className;
                document.getElementById('lblMaterialTitle').innerText = (data.materi && data.materi.judul) ? data.materi.judul : this.state.materialTitle;
                document.getElementById('lblMotivation').innerText = `"${data.motivation || 'Tetap semangat belajar dan bergerak sehat!'}"`;

                // Profil
                const profName = document.getElementById('profName');
                const profClass = document.getElementById('profClass');
                const profilInisial = document.getElementById('profilInisial');
                if (profName) profName.innerText = this.state.studentName;
                if (profClass) profClass.innerText = this.state.className;
                if (profilInisial) profilInisial.innerText = (this.state.studentName || 'U').charAt(0).toUpperCase();

                this.renderMateri(data.materi);
                this.renderLKM(data.lkm);
                this.renderTugas(data.tugas);
                this.renderFormatif(data.formatif, data.formatifLink);
                this.renderRefleksi(data.refleksi);
                this.updateProgress();
            },

            renderMateri(materi) {
                const container = document.getElementById('materiIsiContainer');
                const tocContainer = document.getElementById('materiTocContainer');
                const tocSelect = document.getElementById('materiTocSelect');
                container.innerHTML = '';

                if (!materi) {
                    document.getElementById('materiJudul').innerText = this.state.materialTitle;
                    container.innerHTML = '<p class="text-gray-400 text-sm">Belum ada konten materi untuk topik ini.</p>';
                    return;
                }

                document.getElementById('materiJudul').innerText = materi.judul || this.state.materialTitle;
                if (materi.cover) {
                    document.getElementById('materiCover').src = convertDriveUrl(materi.cover, 'image');
                }

                const tujuanEl = document.getElementById('materiTujuan');
                const tujuanBox = document.getElementById('materiTujuanContainer');
                if (materi.tujuan) {
                    tujuanBox.classList.remove('hidden');
                    tujuanEl.innerHTML = parseMediaTags(materi.tujuan, 'blue');
                } else {
                    tujuanBox.classList.add('hidden');
                }

                const rangkumanEl = document.getElementById('materiRangkuman');
                const rangkumanBox = document.getElementById('materiRangkumanContainer');
                if (materi.rangkuman) {
                    rangkumanBox.classList.remove('hidden');
                    rangkumanEl.innerHTML = parseMediaTags(materi.rangkuman, 'orange');
                } else {
                    rangkumanBox.classList.add('hidden');
                }

                const subbabs = Array.isArray(materi.subbab) ? materi.subbab : [];
                tocSelect.innerHTML = '<option value="">-- Tampilkan Semua Bagian --</option>';

                if (subbabs.length > 0) {
                    tocContainer.classList.remove('hidden');
                    subbabs.forEach((rawSub, idx) => {
                        const lines = String(rawSub).split(/\r?\n/).filter(l => l.trim() !== '');
                        let title = lines.length > 0 ? lines[0].replace(/\*\*/g, '').trim() : `Bagian ${idx + 1}`;
                        if (title.length > 65) title = title.substring(0, 62) + '...';

                        const opt = document.createElement('option');
                        opt.value = String(idx);
                        opt.textContent = title;
                        tocSelect.appendChild(opt);

                        const block = document.createElement('div');
                        block.className = 'materi-subbab-block bg-slate-800/60 border border-slate-700/80 rounded-2xl p-4 md:p-6 space-y-3';
                        block.dataset.idx = String(idx);
                        block.innerHTML = `
                            <h3 class="text-sm md:text-lg font-bold text-brand-orange border-b border-white/10 pb-2">${title}</h3>
                            <div class="text-xs md:text-sm text-gray-200 sheet-text text-justify-custom leading-relaxed">${parseMediaTags(rawSub, 'orange')}</div>
                        `;
                        container.appendChild(block);
                    });
                } else {
                    tocContainer.classList.add('hidden');
                }

                this.scrollToSubbab();
            },

            scrollToSubbab() {
                const select = document.getElementById('materiTocSelect');
                const val = select ? select.value : '';
                const blocks = document.querySelectorAll('.materi-subbab-block');
                const rangkumanBox = document.getElementById('materiRangkumanContainer');
                const btnPrev = document.getElementById('btnPrevSubbab');
                const btnNext = document.getElementById('btnNextSubbab');
                const btnDone = document.getElementById('btnSelesaiMateri');

                if (val === '' || blocks.length === 0) {
                    blocks.forEach(b => b.classList.remove('hidden'));
                    if (rangkumanBox && document.getElementById('materiRangkuman').innerHTML.trim() !== '') {
                        rangkumanBox.classList.remove('hidden');
                    }
                    if (btnPrev) { btnPrev.classList.add('hidden'); btnPrev.classList.remove('inline-flex'); }
                    if (btnNext) { btnNext.classList.add('hidden'); btnNext.classList.remove('inline-flex'); }
                    if (btnDone) btnDone.classList.remove('hidden');
                    return;
                }

                const activeIdx = parseInt(val, 10);
                const isFirst = activeIdx === 0;
                const isLast = activeIdx === blocks.length - 1;

                blocks.forEach((b, i) => {
                    if (i === activeIdx) b.classList.remove('hidden');
                    else b.classList.add('hidden');
                });

                if (rangkumanBox) {
                    if (isLast && document.getElementById('materiRangkuman').innerHTML.trim() !== '') {
                        rangkumanBox.classList.remove('hidden');
                    } else {
                        rangkumanBox.classList.add('hidden');
                    }
                }

                if (btnPrev) {
                    if (!isFirst) { btnPrev.classList.remove('hidden'); btnPrev.classList.add('inline-flex'); }
                    else { btnPrev.classList.add('hidden'); btnPrev.classList.remove('inline-flex'); }
                }

                if (btnNext && btnDone) {
                    if (isLast) {
                        btnNext.classList.add('hidden'); btnNext.classList.remove('inline-flex');
                        btnDone.classList.remove('hidden');
                    } else {
                        btnNext.classList.remove('hidden'); btnNext.classList.add('inline-flex');
                        btnDone.classList.add('hidden');
                    }
                }
            },

            navigateSubbab(delta) {
                const select = document.getElementById('materiTocSelect');
                if (!select || select.value === '') return;
                const nextIdx = parseInt(select.value, 10) + delta;
                if (nextIdx >= 0 && nextIdx < select.options.length - 1) {
                    select.value = String(nextIdx);
                    this.scrollToSubbab();
                    document.querySelector('main')?.scrollTo({ top: 0, behavior: 'smooth' });
                }
            },

            markMateriDone() {
                this.state.progress.materi = true;
                this.saveSession();
                this.updateProgress();
                showModal('Materi Selesai', 'Bagus! Anda telah menyelesaikan bagian materi pembelajaran.', true);
            },

            renderLKM(lkm) {
                const qContainer = document.getElementById('lkmQuestionsContainer');
                const tocContainer = document.getElementById('lkmTocContainer');
                const tocSelect = document.getElementById('lkmTocSelect');
                const infoBox = document.getElementById('lkmInfoContainer');
                qContainer.innerHTML = '';
                this.state.lkmPhases = [];

                if (!lkm) {
                    qContainer.innerHTML = '<p class="text-center text-gray-400 text-sm">Belum ada LKM untuk materi ini.</p>';
                    tocContainer.classList.add('hidden');
                    document.getElementById('lkmSubmitArea').classList.add('hidden');
                    return;
                }

                document.getElementById('lkmJudulUtama').innerText = lkm.judul || 'Lembar Kerja Murid (LKM)';
                if (lkm.tujuan) {
                    infoBox.classList.remove('hidden');
                    document.getElementById('lkmTujuan').innerHTML = parseMediaTags(lkm.tujuan, 'purple');
                } else {
                    infoBox.classList.add('hidden');
                }

                const phases = [];
                if (lkm.kegiatan1 && (lkm.kegiatan1.teks || (lkm.kegiatan1.soalList && lkm.kegiatan1.soalList.length))) {
                    phases.push({ key: 'keg1', title: 'Kegiatan 1: Memahami', theme: 'purple', badge: 'bg-purple-500/20 text-purple-300 border-purple-500/30', teks: lkm.kegiatan1.teks, soals: lkm.kegiatan1.soalList || [] });
                }
                if (lkm.kegiatan2 && (lkm.kegiatan2.teks || (lkm.kegiatan2.soalList && lkm.kegiatan2.soalList.length))) {
                    phases.push({ key: 'keg2', title: 'Kegiatan 2: Menerapkan', theme: 'blue', badge: 'bg-blue-500/20 text-blue-300 border-blue-500/30', teks: lkm.kegiatan2.teks, soals: lkm.kegiatan2.soalList || [] });
                }
                if (lkm.kegiatan3 && (lkm.kegiatan3.teks || (lkm.kegiatan3.soalList && lkm.kegiatan3.soalList.length))) {
                    phases.push({ key: 'keg3', title: 'Kegiatan 3: Menganalisis', theme: 'teal', badge: 'bg-teal-500/20 text-teal-300 border-teal-500/30', teks: lkm.kegiatan3.teks, soals: lkm.kegiatan3.soalList || [] });
                }
                if (lkm.refleksi && (lkm.refleksi.teks || lkm.refleksi.soal)) {
                    phases.push({ key: 'ref', title: 'Kegiatan Penutup: Refleksi LKM', theme: 'orange', badge: 'bg-orange-500/20 text-orange-300 border-orange-500/30', teks: lkm.refleksi.teks, soals: lkm.refleksi.soal ? [lkm.refleksi.soal] : [] });
                }

                this.state.lkmPhases = phases;
                tocSelect.innerHTML = '<option value="">-- Tampilkan Semua Kegiatan --</option>';

                let globalQuestionCounter = 1;
                phases.forEach((ph, pIdx) => {
                    const opt = document.createElement('option');
                    opt.value = String(pIdx);
                    opt.textContent = ph.title;
                    tocSelect.appendChild(opt);

                    const phaseCard = document.createElement('div');
                    phaseCard.className = 'lkm-phase-block bg-slate-900/70 border border-slate-700/80 rounded-2xl p-4 md:p-6 space-y-5 shadow-lg';
                    phaseCard.dataset.idx = String(pIdx);

                    let phaseHtml = `
                        <div class="flex items-center justify-between border-b border-white/10 pb-3">
                            <h3 class="text-sm md:text-lg font-bold text-white">${ph.title}</h3>
                            <span class="text-[11px] font-semibold px-3 py-1 rounded-full border ${ph.badge}">Tahap ${pIdx + 1} dari ${phases.length}</span>
                        </div>
                    `;

                    if (ph.teks) {
                        phaseHtml += `<div class="text-xs md:text-sm text-gray-200 sheet-text text-justify-custom leading-relaxed">${parseMediaTags(ph.teks, ph.theme)}</div>`;
                    }

                    if (ph.soals.length > 0) {
                        phaseHtml += `<div class="grid grid-cols-1 gap-4 pt-2">`;
                        ph.soals.forEach((soalText) => {
                            const qNum = globalQuestionCounter++;
                            phaseHtml += `
                                <div class="bg-slate-800/80 border border-slate-700 rounded-2xl p-4 md:p-5 space-y-3 shadow-inner">
                                    <div class="flex items-center gap-2">
                                        <span class="px-2.5 py-0.5 rounded-lg text-[11px] font-bold border ${ph.badge}">Pertanyaan ${qNum}</span>
                                    </div>
                                    <div class="text-xs md:text-sm text-gray-100 sheet-text text-justify-custom leading-relaxed">${parseMediaTags(soalText, ph.theme)}</div>
                                    <textarea name="lkm_answer_${qNum}" rows="3" required placeholder="Tuliskan jawaban Anda untuk Pertanyaan ${qNum} di sini..." class="lkm-answer-input w-full bg-slate-950/90 border border-slate-600 rounded-xl p-3.5 text-xs md:text-sm text-white focus:outline-none focus:border-purple-400 transition-colors"></textarea>
                                </div>
                            `;
                        });
                        phaseHtml += `</div>`;
                    }

                    phaseCard.innerHTML = phaseHtml;
                    qContainer.appendChild(phaseCard);
                });

                if (phases.length > 1) {
                    tocContainer.classList.remove('hidden');
                } else {
                    tocContainer.classList.add('hidden');
                }

                document.getElementById('lkmSubmitArea').classList.remove('hidden');
                this.scrollToLkmPhase();
            },

            scrollToLkmPhase() {
                const select = document.getElementById('lkmTocSelect');
                const val = select ? select.value : '';
                const blocks = document.querySelectorAll('.lkm-phase-block');
                const btnPrev = document.getElementById('btnPrevLkm');
                const btnNext = document.getElementById('btnNextLkm');
                const btnSubmit = document.getElementById('btnSubmitLkm');

                // Jika memilih "-- Tampilkan Semua Kegiatan --"
                if (val === '' || blocks.length === 0) {
                    blocks.forEach(b => b.classList.remove('hidden'));
                    if (btnPrev) { btnPrev.classList.add('hidden'); btnPrev.classList.remove('inline-flex'); }
                    if (btnNext) { btnNext.classList.add('hidden'); btnNext.classList.remove('inline-flex'); }
                    if (btnSubmit) { btnSubmit.classList.remove('hidden'); btnSubmit.classList.add('flex'); }
                    return;
                }

                const activeIdx = parseInt(val, 10);
                const isFirst = activeIdx === 0;
                const isLast = activeIdx === blocks.length - 1;

                blocks.forEach((b, i) => {
                    if (i === activeIdx) b.classList.remove('hidden');
                    else b.classList.add('hidden');
                });

                // Tombol Kembali di sebelah kiri
                if (btnPrev) {
                    if (!isFirst) { btnPrev.classList.remove('hidden'); btnPrev.classList.add('inline-flex'); }
                    else { btnPrev.classList.add('hidden'); btnPrev.classList.remove('inline-flex'); }
                }

                // Tombol Lanjutkan di kanan, atau Kirim Jawaban LKM pada kegiatan terakhir
                if (btnNext && btnSubmit) {
                    if (isLast) {
                        btnNext.classList.add('hidden'); btnNext.classList.remove('inline-flex');
                        btnSubmit.classList.remove('hidden'); btnSubmit.classList.add('flex');
                    } else {
                        btnNext.classList.remove('hidden'); btnNext.classList.add('inline-flex');
                        btnSubmit.classList.add('hidden'); btnSubmit.classList.remove('flex');
                    }
                }
            },

            navigateLkmPhase(delta) {
                const select = document.getElementById('lkmTocSelect');
                if (!select || select.value === '') return;
                const nextIdx = parseInt(select.value, 10) + delta;
                if (nextIdx >= 0 && nextIdx < this.state.lkmPhases.length) {
                    select.value = String(nextIdx);
                    this.scrollToLkmPhase();
                    document.querySelector('main')?.scrollTo({ top: 0, behavior: 'smooth' });
                }
            },

            async submitLKM(e) {
                e.preventDefault();
                const inputs = document.querySelectorAll('.lkm-answer-input');
                const answers = Array.from(inputs).map((inp, i) => `J${i + 1}: ${inp.value.trim()}`);

                if (answers.some(a => a.endsWith(':'))) {
                    showModal('Belum Lengkap', 'Mohon lengkapi semua kolom jawaban LKM terlebih dahulu sebelum mengirim.', false);
                    return;
                }

                setLoading(true);
                try {
                    const res = await api({
                        action: 'submitData',
                        type: 'lkm',
                        studentName: this.state.studentName,
                        className: this.state.className,
                        materialId: this.state.materialId,
                        answers
                    });

                    this.state.progress.lkm = true;
                    this.saveSession();
                    this.updateProgress();

                    document.getElementById('lkmForm').classList.add('hidden');
                    document.getElementById('lkmTocContainer').classList.add('hidden');
                    document.getElementById('lkmDoneState').classList.remove('hidden');

                    if (res && res.data && res.data.feedback) {
                        document.getElementById('lkmAiFeedbackCard').classList.remove('hidden');
                        document.getElementById('lkmAiScore').innerText = `Pemahaman: ${res.data.score || 85}%`;
                        document.getElementById('lkmAiFeedbackContent').innerText = res.data.feedback;
                    }
                } catch (err) {
                    showModal('Gagal Mengirim', 'Terjadi kendala saat menyimpan LKM. Silakan coba lagi.', false);
                } finally {
                    setLoading(false);
                }
            },


<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PJOK Digital Learning</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        // Inisialisasi awal objek global app agar tidak pernah undefined saat elemen HTML dimuat
        var app = window.app = window.app || {};

        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            navy: '#0f172a',
                            orange: '#f97316',
                            orangeHover: '#ea580c',
                            blue: '#2563eb'
                        }
                    }
                }
            }
        };
    </script>
    <style>
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        
        .glass-card {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .bg-cinematic {
            background-image: linear-gradient(to bottom, rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.95)), url('https://images.unsplash.com/photo-1541534741688-6078c6bfb5c5?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
            background-size: cover; background-position: center; background-attachment: fixed;
        }

        .bg-dashboard {
            background-image: linear-gradient(to right, rgba(15, 23, 42, 0.95), rgba(15, 23, 42, 0.95)), url('https://images.unsplash.com/photo-1517649763962-0c623066013b?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
            background-size: cover; background-position: center; background-attachment: fixed;
        }

        .sidebar-collapsed .nav-text, .sidebar-collapsed #sidebarLogoText, .sidebar-collapsed #sidebarMenuLabel, .sidebar-collapsed .mobile-title { display: none !important; }
        .sidebar-collapsed .nav-link, .sidebar-collapsed .logout-link { justify-content: center !important; padding-left: 0 !important; padding-right: 0 !important; }

        /* SIDEBAR DRAWER MOBILE */
        @media (max-width: 767px) {
            #appSidebar {
                position: fixed;
                top: 0;
                left: -100%;
                width: 280px;
                height: 100%;
                z-index: 90;
                transition: left 0.3s ease-in-out;
            }
            #appSidebar.mobile-open {
                left: 0;
            }
            #sidebarOverlay {
                display: none;
            }
            #sidebarOverlay.active {
                display: block;
            }
        }

        .media-container img { border-radius: 12px; max-width: 100%; height: auto; margin: 1rem auto; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.5); }
        .media-container iframe, .media-container video { width: 100%; aspect-ratio: 16/9; border-radius: 12px; border: none; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.5); }
        
        .sheet-text { white-space: pre-wrap; word-wrap: break-word; }
        .text-justify-custom { text-align: justify; text-justify: inter-word; }

        /* MENCEGAH SELEKSI TEKS UNTUK MENCEGAH COPY PASTE */
        body, input, textarea, select {
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }
    </style>
</head>
<body class="bg-brand-navy text-white font-sans antialiased overflow-x-hidden min-h-screen" oncontextmenu="return false;">

    <!-- GLOBAL MODAL -->
    <div id="globalModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-sm">
        <div class="glass-card p-8 rounded-2xl max-w-sm w-full mx-4 text-center shadow-2xl">
            <div id="modalIcon" class="text-4xl mb-4"></div>
            <h3 id="modalTitle" class="text-xl font-bold mb-2 text-white"></h3>
            <p id="modalMessage" class="text-gray-300 mb-6"></p>
            <button type="button" onclick="closeModal()" class="w-full bg-brand-orange hover:bg-brand-orangeHover text-white font-semibold py-3 rounded-xl transition-all">Tutup</button>
        </div>
    </div>

    <!-- LOADING SCREEN -->
    <div id="loadingScreen" class="fixed inset-0 z-[110] hidden items-center justify-center bg-brand-navy/90 backdrop-blur-md">
        <div class="flex flex-col items-center">
            <div class="w-16 h-16 border-4 border-brand-orange border-t-transparent rounded-full animate-spin"></div>
            <p class="mt-4 text-brand-orange font-semibold tracking-widest animate-pulse">MEMPROSES DATA...</p>
        </div>
    </div>

    <!-- VIEW 1: WELCOME SCREEN -->
    <div id="view-welcome" class="min-h-screen flex flex-col items-center justify-center bg-cinematic p-6 relative">
        <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-transparent to-transparent"></div>
        <div class="z-10 text-center max-w-3xl flex flex-col items-center justify-center">
            <!-- LOGO UTAMA PJOK CERIA DAN DINAMIS -->
            <img src="Logo PJOK Ceria dan Dinamis.png" 
                 onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1541534741688-6078c6bfb5c5?w=300';" 
                 alt="Logo PJOK Ceria dan Dinamis" 
                 class="w-32 h-32 md:w-44 md:h-44 mx-auto mb-6 rounded-full border-4 border-brand-orange object-cover shadow-[0_0_35px_rgba(249,115,22,0.5)]">
            
            <!-- JUDUL UTAMA -->
            <h1 class="text-3xl md:text-5xl font-black mb-3 tracking-tight text-white drop-shadow-lg">PJOK DIGITAL LEARNING</h1>
            
            <!-- SUB-JUDUL & SLOGAN DI ATAS TOMBOL -->
            <p class="text-sm md:text-xl text-gray-200 font-medium mb-2 tracking-wide max-w-2xl">
                Aplikasi Pembelajaran Digital Pendidikan Jasmani, Olahraga, dan Kesehatan
            </p>
            <p class="text-xs md:text-base text-brand-orange font-bold italic mb-8 tracking-wider">
                "Belajar Aktif, Bergerak Sehat, Berprestasi Hebat."
            </p>

            <!-- TOMBOL DI BAGIAN PALING BAWAH TEKS -->
            <button type="button" id="btnStartWelcome" onclick="app.checkConnectionAndStart()" class="px-8 py-4 bg-brand-orange hover:bg-brand-orangeHover text-white text-base md:text-lg font-bold rounded-full transition-all shadow-[0_0_25px_rgba(249,115,22,0.5)] hover:-translate-y-1 cursor-pointer">
                MULAI PEMBELAJARAN <i class="fa-solid fa-arrow-right ml-2"></i>
            </button>
        </div>
    </div>

    <!-- VIEW 2: IDENTITAS MURID -->
    <div id="view-identity" class="min-h-screen hidden flex-col items-center justify-center bg-cinematic p-4 relative">
        <div class="absolute inset-0 bg-brand-navy/80"></div>
        <div class="z-10 w-full max-w-md">
            <div class="glass-card p-8 rounded-3xl shadow-2xl">
                <div class="text-center mb-8">
                    <h2 class="text-3xl font-bold text-white mb-2">Identitas Diri</h2>
                    <p class="text-gray-400 text-sm">Lengkapi data untuk memulai sesi belajar</p>
                </div>
                <form id="identityForm" onsubmit="app.submitIdentity(event)" class="space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Kelas</label>
                        <select id="selectClass" onchange="app.onClassChange()" required class="w-full bg-slate-800/80 border border-slate-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-brand-orange">
                            <option value="">-- Pilih Kelas --</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Nama Murid</label>
                        <select id="selectStudent" required disabled class="w-full bg-slate-800/80 border border-slate-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-brand-orange disabled:opacity-50">
                            <option value="">-- Pilih Nama --</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-300 mb-1">Materi Pembelajaran</label>
                        <select id="selectMaterial" required disabled class="w-full bg-slate-800/80 border border-slate-600 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-brand-orange disabled:opacity-50">
                            <option value="">-- Pilih Materi --</option>
                        </select>
                    </div>
                    <button type="submit" id="btnContinue" disabled class="w-full mt-6 bg-brand-blue hover:bg-blue-700 text-white font-bold py-4 rounded-xl disabled:opacity-50 shadow-lg cursor-pointer">LANJUTKAN</button>
                </form>
            </div>
        </div>
    </div>

    <!-- MAIN APP WRAPPER -->
    <div id="view-main" class="hidden h-screen w-full bg-dashboard flex flex-col md:flex-row overflow-hidden">
        
        <!-- BACKDROP OVERLAY LAYAR HP SAAT MENU DIBUKA -->
        <div id="sidebarOverlay" onclick="app.toggleSidebar()" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-40 md:hidden"></div>

        <!-- SIDEBAR -->
        <aside id="appSidebar" class="md:w-64 glass-card border-r border-white/10 md:h-full flex flex-col transition-all duration-300 z-50 shrink-0">
            <div class="flex items-center justify-between p-4 md:p-6">
                <div class="flex items-center gap-3 overflow-hidden">
                    <div class="w-10 h-10 rounded-full bg-brand-orange flex items-center justify-center text-white font-black shrink-0">P</div>
                    <span id="sidebarLogoText" class="font-bold text-lg hidden md:block">PJOK DIGITAL</span>
                    <span class="font-bold text-lg mobile-title md:hidden">PJOK DIGITAL</span>
                </div>
                <button type="button" onclick="app.toggleSidebar()" class="text-2xl text-gray-300 hover:text-white p-1"><i class="fa-solid fa-xmark md:fa-bars"></i></button>
            </div>

            <nav id="sidebarNav" class="flex flex-col flex-1 p-4 gap-2 overflow-y-auto">
                <a href="#" onclick="app.navigateTo('dashboard'); return false;" class="nav-link active flex items-center gap-3 px-4 py-3 rounded-xl text-gray-300 hover:bg-white/10" data-target="dashboard"><i class="fa-solid fa-house w-5"></i> <span class="nav-text">Dashboard</span></a>
                <a href="#" onclick="app.navigateTo('materi'); return false;" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-gray-300 hover:bg-white/10" data-target="materi"><i class="fa-solid fa-book-open w-5"></i> <span class="nav-text">Materi</span></a>
                <a href="#" onclick="app.navigateTo('lkm'); return false;" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-gray-300 hover:bg-white/10" data-target="lkm"><i class="fa-solid fa-file-signature w-5"></i> <span class="nav-text">LKM</span></a>
                <a href="#" onclick="app.navigateTo('tugas'); return false;" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-gray-300 hover:bg-white/10" data-target="tugas"><i class="fa-solid fa-upload w-5"></i> <span class="nav-text">Tugas</span></a>
                <a href="#" onclick="app.navigateTo('formatif'); return false;" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-gray-300 hover:bg-white/10" data-target="formatif"><i class="fa-solid fa-stopwatch w-5"></i> <span class="nav-text">Formatif</span></a>
                <a href="#" onclick="app.navigateTo('refleksi'); return false;" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-gray-300 hover:bg-white/10" data-target="refleksi"><i class="fa-solid fa-comment-dots w-5"></i> <span class="nav-text">Refleksi</span></a>
                
                <div class="mt-auto pt-4 border-t border-white/10">
                    <a href="#" onclick="app.navigateTo('profil'); return false;" class="nav-link flex items-center gap-3 px-4 py-3 rounded-xl text-gray-300 hover:bg-white/10" data-target="profil"><i class="fa-solid fa-user w-5"></i> <span class="nav-text">Profil Saya</span></a>
                    <a href="#" onclick="app.logout(); return false;" class="logout-link flex items-center gap-3 px-4 py-3 mt-2 rounded-xl text-red-400 hover:bg-red-500/20"><i class="fa-solid fa-sign-out-alt w-5"></i> <span class="nav-text">Keluar</span></a>
                </div>
            </nav>
        </aside>

        <!-- HEADER BAR UTAMA KHUSUS LAYAR HP (MOBILE TOP BAR) -->
        <div class="md:hidden flex items-center justify-between p-4 glass-card border-b border-white/10 sticky top-0 z-30 shrink-0">
            <div class="flex items-center gap-3">
                <button type="button" id="btnMobileBack" onclick="app.goBack()" class="w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-white hover:bg-slate-700">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
                <span id="lblMobileHeaderTitle" class="font-bold text-white text-base capitalize">Dashboard</span>
            </div>
            <button type="button" onclick="app.toggleSidebar()" class="w-10 h-10 rounded-xl bg-brand-orange text-white flex items-center justify-center font-bold">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>

        <!-- MAIN CONTENT AREA -->
        <main class="flex-1 p-4 md:p-8 h-full overflow-y-auto relative">
            
            <!-- DASHBOARD CONTENT -->
            <div id="content-dashboard" class="content-section">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-3">
                    <div>
                        <h2 class="text-xl md:text-3xl font-bold text-white mb-1">Selamat Datang, <span id="lblStudentName" class="text-brand-orange">Murid</span>!</h2>
                        <p class="text-xs md:text-sm text-gray-400 flex items-center gap-2">
                            <i class="fa-solid fa-users"></i> <span id="lblStudentClass">Kelas</span> | 
                            <i class="fa-solid fa-book"></i> <span id="lblMaterialTitle" class="text-blue-300 font-medium">Materi</span>
                        </p>
                    </div>
                    <div class="glass-card px-4 py-2 md:px-6 md:py-3 rounded-2xl flex items-center gap-3">
                        <div>
                            <p class="text-[10px] md:text-xs text-gray-400">Progres Sesi Ini</p>
                            <p class="text-lg md:text-2xl font-bold text-white" id="lblTotalProgress">0%</p>
                        </div>
                        <div class="w-9 h-9 md:w-12 md:h-12 rounded-full border-2 md:border-4 border-brand-orange flex items-center justify-center text-brand-orange text-sm md:text-base"><i class="fa-solid fa-trophy"></i></div>
                    </div>
                </div>

                <div class="glass-card rounded-2xl p-4 md:p-6 mb-6 border-l-4 border-brand-orange shadow-lg relative overflow-hidden">
                    <p class="text-[10px] md:text-xs text-brand-orange font-bold uppercase tracking-widest mb-1">Motivasi Hari Ini</p>
                    <p id="lblMotivation" class="text-sm md:text-xl font-light italic text-white leading-relaxed">"Memuat motivasi..."</p>
                </div>

                <h3 class="text-base md:text-xl font-bold mb-3 border-b border-white/10 pb-2">Status Pembelajaran</h3>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
                    <div class="glass-card p-4 rounded-2xl cursor-pointer hover:bg-white/10" onclick="app.navigateTo('materi')">
                        <div class="flex justify-between items-center mb-2"><div class="w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center text-blue-400 text-xs md:text-base"><i class="fa-solid fa-book-open"></i></div><span id="status-materi-icon"><i class="fa-regular fa-circle text-gray-500 text-xs"></i></span></div>
                        <h4 class="font-bold text-sm md:text-base">Materi</h4>
                    </div>
                    <div class="glass-card p-4 rounded-2xl cursor-pointer hover:bg-white/10" onclick="app.navigateTo('lkm')">
                        <div class="flex justify-between items-center mb-2"><div class="w-8 h-8 rounded-full bg-purple-500/20 flex items-center justify-center text-purple-400 text-xs md:text-base"><i class="fa-solid fa-file-signature"></i></div><span id="status-lkm-icon"><i class="fa-regular fa-circle text-gray-500 text-xs"></i></span></div>
                        <h4 class="font-bold text-sm md:text-base">LKM</h4>
                    </div>
                    <div class="glass-card p-4 rounded-2xl cursor-pointer hover:bg-white/10" onclick="app.navigateTo('tugas')">
                        <div class="flex justify-between items-center mb-2"><div class="w-8 h-8 rounded-full bg-orange-500/20 flex items-center justify-center text-orange-400 text-xs md:text-base"><i class="fa-solid fa-upload"></i></div><span id="status-tugas-icon"><i class="fa-regular fa-circle text-gray-500 text-xs"></i></span></div>
                        <h4 class="font-bold text-sm md:text-base">Tugas</h4>
                    </div>
                    <div class="glass-card p-4 rounded-2xl cursor-pointer hover:bg-white/10" onclick="app.navigateTo('formatif')">
                        <div class="flex justify-between items-center mb-2"><div class="w-8 h-8 rounded-full bg-red-500/20 flex items-center justify-center text-red-400 text-xs md:text-base"><i class="fa-solid fa-stopwatch"></i></div><span id="status-formatif-icon"><i class="fa-regular fa-circle text-gray-500 text-xs"></i></span></div>
                        <h4 class="font-bold text-sm md:text-base">Formatif</h4>
                    </div>
                    <div class="glass-card p-4 rounded-2xl cursor-pointer hover:bg-white/10" onclick="app.navigateTo('refleksi')">
                        <div class="flex justify-between items-center mb-2"><div class="w-8 h-8 rounded-full bg-teal-500/20 flex items-center justify-center text-teal-400 text-xs md:text-base"><i class="fa-solid fa-comment-dots"></i></div><span id="status-refleksi-icon"><i class="fa-regular fa-circle text-gray-500 text-xs"></i></span></div>
                        <h4 class="font-bold text-sm md:text-base">Refleksi</h4>
                    </div>
                </div>
            </div>

            <!-- MATERI CONTENT -->
            <div id="content-materi" class="content-section hidden max-w-4xl mx-auto">
                <div class="glass-card rounded-3xl overflow-hidden shadow-2xl">
                    <div class="relative h-48 md:h-72">
                        <img id="materiCover" src="https://images.unsplash.com/photo-1517649763962-0c623066013b?w=1000" class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/50 to-transparent flex items-end p-5 md:p-8">
                            <div>
                                <span class="bg-brand-orange text-white text-[10px] md:text-xs font-bold px-3 py-1 rounded-full uppercase mb-2 inline-block">Materi Pembelajaran</span>
                                <h2 id="materiJudul" class="text-xl md:text-4xl font-bold text-white">Judul Materi</h2>
                            </div>
                        </div>
                    </div>
                    
                    <div class="p-4 md:p-10 bg-slate-900/90 text-gray-200 leading-relaxed space-y-6">
                        <div id="materiTujuanContainer" class="bg-blue-900/30 border-l-4 border-blue-500 p-4 md:p-5 rounded-r-xl">
                            <h4 class="text-blue-400 font-bold mb-2 flex items-center gap-2 text-sm md:text-lg"><i class="fa-solid fa-bullseye"></i> Tujuan Pembelajaran</h4>
                            <div id="materiTujuan" class="text-xs md:text-base sheet-text text-justify-custom leading-relaxed"></div>
                        </div>

                        <div id="materiTocContainer" class="hidden bg-slate-800/80 p-4 rounded-xl border border-slate-700 shadow-inner mt-4">
                            <label class="block text-xs md:text-sm font-bold text-gray-300 mb-2"><i class="fa-solid fa-list-ul text-brand-orange mr-2"></i> Pilih Sub Topik (Mode Fokus):</label>
                            <select id="materiTocSelect" onchange="app.scrollToSubbab()" class="w-full bg-slate-900 border border-slate-600 rounded-xl px-3 py-2.5 text-xs md:text-sm text-white focus:outline-none focus:border-brand-orange">
                                <option value="">-- Tampilkan Semua Bagian --</option>
                            </select>
                        </div>

                        <div class="space-y-4 md:space-y-6 mt-6" id="materiIsiContainer"></div>
                        
                        <div id="materiRangkumanContainer" class="bg-brand-orange/10 border-l-4 border-brand-orange p-4 md:p-5 rounded-r-xl mt-6">
                            <h4 class="text-brand-orange font-bold mb-2 flex items-center gap-2 text-sm md:text-lg"><i class="fa-solid fa-clipboard-list"></i> Rangkuman</h4>
                            <div id="materiRangkuman" class="text-xs md:text-base sheet-text text-justify-custom leading-relaxed"></div>
                        </div>
                    </div>
                    
                    <div class="p-6 bg-slate-900 border-t border-slate-800 flex items-center justify-between gap-3">
                        <button type="button" id="btnPrevSubbab" onclick="app.navigateSubbab(-1)" class="hidden bg-slate-800 hover:bg-slate-700 text-white px-4 md:px-6 py-3 rounded-xl font-bold text-xs md:text-base transition-all items-center">
                            <i class="fa-solid fa-arrow-left mr-2"></i> KEMBALI
                        </button>
                        <div class="ml-auto flex items-center gap-3">
                            <button type="button" id="btnNextSubbab" onclick="app.navigateSubbab(1)" class="hidden bg-brand-orange hover:bg-brand-orangeHover text-white px-4 md:px-6 py-3 rounded-xl font-bold text-xs md:text-base transition-all items-center">
                                LANJUTKAN <i class="fa-solid fa-arrow-right ml-2"></i>
                            </button>
                            <button type="button" id="btnSelesaiMateri" onclick="app.markMateriDone()" class="bg-brand-blue hover:bg-blue-600 text-white px-5 md:px-6 py-3 rounded-xl font-bold text-xs md:text-base transition-all">
                                <i class="fa-solid fa-check mr-2"></i> TANDAI SELESAI
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- LKM CONTENT -->
            <div id="content-lkm" class="content-section hidden max-w-3xl mx-auto">
                <div class="glass-card p-6 md:p-8 rounded-3xl shadow-xl">
                    <div class="text-center mb-8">
                        <div class="w-16 h-16 bg-purple-500/20 text-purple-400 rounded-full flex items-center justify-center text-2xl mx-auto mb-4"><i class="fa-solid fa-file-signature"></i></div>
                        <h2 id="lkmJudulUtama" class="text-2xl md:text-3xl font-bold text-white mb-2">Lembar Kerja Murid (LKM)</h2>
                    </div>
                    
                    <div id="lkmInfoContainer" class="hidden bg-purple-900/20 border border-purple-500/30 p-4 md:p-5 rounded-2xl mb-5">
                        <h3 class="text-base md:text-xl font-bold text-purple-400 mb-2 flex items-center gap-2"><i class="fa-solid fa-bullseye"></i> A. Tujuan Pembelajaran</h3>
                        <div id="lkmTujuan" class="text-gray-300 text-xs md:text-base sheet-text text-justify-custom leading-relaxed"></div>
                    </div>

                    <!-- DROPDOWN NAVIGASI / MODE FOKUS UNTUK LKM -->
                    <div id="lkmTocContainer" class="hidden bg-slate-800/80 p-4 rounded-xl border border-slate-700 shadow-inner mb-5">
                        <label class="block text-xs md:text-sm font-bold text-gray-300 mb-2"><i class="fa-solid fa-list-check text-purple-400 mr-2"></i> Pilih Kegiatan LKM (Mode Fokus):</label>
                        <select id="lkmTocSelect" onchange="app.scrollToLkmPhase()" class="w-full bg-slate-900 border border-slate-600 rounded-xl px-3 py-2.5 text-xs md:text-sm text-white focus:outline-none focus:border-purple-500">
                            <option value="">-- Tampilkan Semua Kegiatan --</option>
                        </select>
                    </div>

                    <form id="lkmForm" onsubmit="app.submitLKM(event)" class="space-y-6">

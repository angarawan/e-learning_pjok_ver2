            renderFormatif(formatif, formatifLink) {
                const intro = document.getElementById('formatifIntro');
                const linkArea = document.getElementById('formatifLinkArea');
                const quizArea = document.getElementById('formatifQuizArea');
                const resultArea = document.getElementById('formatifResultArea');

                intro.classList.remove('hidden');
                linkArea.classList.add('hidden');
                quizArea.classList.add('hidden');
                resultArea.classList.add('hidden');

                if (formatifLink) {
                    document.getElementById('btnExternalQuizLink').href = formatifLink;
                }
            },

            startFormatif() {
                const data = this.state.dashboardData || {};
                document.getElementById('formatifIntro').classList.add('hidden');

                if (data.formatifLink) {
                    document.getElementById('formatifLinkArea').classList.remove('hidden');
                    return;
                }

                const questions = Array.isArray(data.formatif) ? data.formatif : [];
                if (questions.length === 0) {
                    showModal('Info', 'Belum ada soal asesmen formatif untuk materi ini.', false);
                    document.getElementById('formatifIntro').classList.remove('hidden');
                    return;
                }

                this.state.currentQuizIdx = 0;
                this.state.quizAnswers = new Array(questions.length).fill(null);
                document.getElementById('formatifQuizArea').classList.remove('hidden');
                this.renderQuizQuestion();
            },

            renderQuizQuestion() {
                const questions = this.state.dashboardData.formatif || [];
                const idx = this.state.currentQuizIdx;
                const q = questions[idx];
                if (!q) return;

                document.getElementById('quizCurrentNum').innerText = String(idx + 1);
                document.getElementById('quizTotalNum').innerText = String(questions.length);
                document.getElementById('quizProgressBar').style.width = `${((idx + 1) / questions.length) * 100}%`;
                document.getElementById('quizQuestion').innerHTML = parseMediaTags(q.text, 'orange');

                const optsContainer = document.getElementById('quizOptions');
                optsContainer.innerHTML = '';
                const labels = ['A', 'B', 'C', 'D'];

                q.options.forEach((optText, oIdx) => {
                    if (!optText && optText !== 0) return;
                    const selected = this.state.quizAnswers[idx] === oIdx;
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = `w-full text-left p-4 rounded-xl border transition-all flex items-center gap-3 ${selected
                        ? 'bg-brand-orange/20 border-brand-orange text-white font-semibold'
                        : 'bg-slate-800/80 border-slate-700 text-gray-300 hover:bg-slate-800'}`;
                    btn.innerHTML = `<span class="w-8 h-8 rounded-lg flex items-center justify-center font-bold text-sm ${selected ? 'bg-brand-orange text-white' : 'bg-slate-700 text-gray-300'}">${labels[oIdx] || oIdx + 1}</span><span class="flex-1 text-sm md:text-base">${optText}</span>`;
                    btn.onclick = () => {
                        this.state.quizAnswers[idx] = oIdx;
                        this.renderQuizQuestion();
                    };
                    optsContainer.appendChild(btn);
                });

                document.getElementById('btnQuizPrev').disabled = idx === 0;
                const isLast = idx === questions.length - 1;
                document.getElementById('btnQuizNext').classList.toggle('hidden', isLast);
                document.getElementById('btnQuizSubmit').classList.toggle('hidden', !isLast);
            },

            quizNav(delta) {
                const questions = this.state.dashboardData.formatif || [];
                const next = this.state.currentQuizIdx + delta;
                if (next >= 0 && next < questions.length) {
                    this.state.currentQuizIdx = next;
                    this.renderQuizQuestion();
                }
            },

            async submitFormatif() {
                const questions = this.state.dashboardData.formatif || [];
                let correct = 0;
                questions.forEach((q, i) => {
                    const userAns = this.state.quizAnswers[i];
                    if (userAns !== null && (userAns + 1 === q.answer || userAns === q.answer)) {
                        correct++;
                    }
                });
                const score = questions.length > 0 ? Math.round((correct / questions.length) * 100) : 0;

                setLoading(true);
                try {
                    await api({
                        action: 'submitData',
                        type: 'formatif',
                        studentName: this.state.studentName,
                        className: this.state.className,
                        materialId: this.state.materialId,
                        answers: this.state.quizAnswers,
                        score
                    });
                    this.state.progress.formatif = true;
                    this.state.quizScore = score;
                    this.saveSession();
                    this.updateProgress();

                    document.getElementById('formatifQuizArea').classList.add('hidden');
                    document.getElementById('formatifResultArea').classList.remove('hidden');
                    document.getElementById('scoreText').innerText = String(score);
                } catch (err) {
                    showModal('Gagal', 'Gagal menyimpan nilai asesmen.', false);
                } finally {
                    setLoading(false);
                }
            },

            markFormatifExternalDone() {
                this.state.progress.formatif = true;
                this.state.quizScore = 100;
                this.saveSession();
                this.updateProgress();
                showModal('Selesai', 'Asesmen formatif telah ditandai selesai!', true);
            },

            renderRefleksi(refleksi) {
                const container = document.getElementById('refleksiQuestionsContainer');
                container.innerHTML = '';
                const questions = (refleksi && Array.isArray(refleksi.questions) && refleksi.questions.length > 0)
                    ? refleksi.questions
                    : [
                        { id: 'R1', text: 'Apa hal paling bermanfaat yang kamu pelajari hari ini?' },
                        { id: 'R2', text: 'Bagaimana perasaanmu selama mengikuti pembelajaran PJOK ini?' }
                    ];

                questions.forEach((q, idx) => {
                    const div = document.createElement('div');
                    div.className = 'bg-slate-800/80 border border-slate-700 rounded-2xl p-4 space-y-2';
                    div.innerHTML = `
                        <label class="block text-xs md:text-sm font-semibold text-teal-300 text-justify-custom">${idx + 1}. ${q.text}</label>
                        <textarea data-q="${q.text}" rows="3" required placeholder="Tuliskan refleksi Anda..." class="refleksi-input w-full bg-slate-900 border border-slate-600 rounded-xl p-3 text-xs md:text-sm text-white focus:border-teal-400"></textarea>
                    `;
                    container.appendChild(div);
                });
            },

            async submitRefleksi(e) {
                e.preventDefault();
                const inputs = document.querySelectorAll('.refleksi-input');
                const refleksi = Array.from(inputs).map(inp => ({
                    question: inp.dataset.q,
                    answer: inp.value.trim()
                }));

                setLoading(true);
                try {
                    await api({
                        action: 'submitData',
                        type: 'refleksi',
                        studentName: this.state.studentName,
                        className: this.state.className,
                        materialId: this.state.materialId,
                        refleksi
                    });
                    this.state.progress.refleksi = true;
                    this.saveSession();
                    this.updateProgress();

                    document.getElementById('refleksiForm').classList.add('hidden');
                    document.getElementById('refleksiDoneState').classList.remove('hidden');
                } catch (err) {
                    showModal('Gagal', 'Gagal mengirim refleksi.', false);
                } finally {
                    setLoading(false);
                }
            },

            updateProgress() {
                const keys = ['materi', 'lkm', 'tugas', 'formatif', 'refleksi'];
                let doneCount = 0;
                keys.forEach(k => {
                    const done = !!this.state.progress[k];
                    if (done) doneCount++;
                    const iconEl = document.getElementById(`status-${k}-icon`);
                    if (iconEl) {
                        iconEl.innerHTML = done
                            ? '<i class="fa-solid fa-circle-check text-green-400 text-sm"></i>'
                            : '<i class="fa-regular fa-circle text-gray-500 text-xs"></i>';
                    }
                });

                const pct = Math.round((doneCount / keys.length) * 100);
                const lblPct = document.getElementById('lblTotalProgress');
                if (lblPct) lblPct.innerText = `${pct}%`;

                const pMat = document.getElementById('profStatMateri');
                const pTug = document.getElementById('profStatTugas');
                const pNil = document.getElementById('profStatNilai');
                const pRef = document.getElementById('profStatRefleksi');
                if (pMat) pMat.innerText = `${this.state.progress.materi ? 1 : 0}/1`;
                if (pTug) pTug.innerText = `${this.state.progress.tugas ? 1 : 0}/1`;
                if (pNil) pNil.innerText = this.state.quizScore !== null ? String(this.state.quizScore) : '-';
                if (pRef) pRef.innerText = `${this.state.progress.refleksi ? 1 : 0}/1`;
            },

            navigateTo(target) {
                document.querySelectorAll('.content-section').forEach(sec => sec.classList.add('hidden'));
                const activeSec = document.getElementById(`content-${target}`);
                if (activeSec) activeSec.classList.remove('hidden');

                document.querySelectorAll('.nav-link').forEach(link => {
                    if (link.dataset.target === target) {
                        link.classList.add('active', 'bg-brand-orange', 'text-white');
                        link.classList.remove('text-gray-300');
                    } else {
                        link.classList.remove('active', 'bg-brand-orange', 'text-white');
                        link.classList.add('text-gray-300');
                    }
                });

                const headerTitle = document.getElementById('lblMobileHeaderTitle');
                if (headerTitle) headerTitle.innerText = target;

                this.state.currentView = target;
                if (this.state.history[this.state.history.length - 1] !== target) {
                    this.state.history.push(target);
                }

                // Tutup sidebar mobile secara otomatis setelah klik menu
                const sidebar = document.getElementById('appSidebar');
                const overlay = document.getElementById('sidebarOverlay');
                if (sidebar && sidebar.classList.contains('mobile-open')) {
                    sidebar.classList.remove('mobile-open');
                    if (overlay) overlay.classList.remove('active');
                }
            },

            goBack() {
                if (this.state.currentView !== 'dashboard') {
                    this.navigateTo('dashboard');
                }
            },

            toggleSidebar() {
                const sidebar = document.getElementById('appSidebar');
                const overlay = document.getElementById('sidebarOverlay');
                if (!sidebar) return;

                if (window.innerWidth < 768) {
                    sidebar.classList.toggle('mobile-open');
                    if (overlay) overlay.classList.toggle('active');
                } else {
                    sidebar.classList.toggle('sidebar-collapsed');
                    sidebar.classList.toggle('md:w-64');
                    sidebar.classList.toggle('md:w-20');
                }
            },

            logout() {
                try { localStorage.removeItem('pjok_session'); } catch (e) {}
                document.getElementById('view-main').classList.add('hidden');
                document.getElementById('view-welcome').classList.remove('hidden');
            }
        });

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => window.app.init());
        } else {
            window.app.init();
        }
    </script>
</body>
</html>
